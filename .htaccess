# Desktop Monkey — site statique. Le serveur ne renvoyait que max-age=14400 (4 h),
# donc chaque visiteur retelechargeait toutes les videos.

<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  # La police ne changera jamais : son contenu est fige par son nom.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Medias : longue duree, mais PAS immutable — les noms ne portent pas de hash,
  # donc un remplacement doit pouvoir etre revalide.
  <FilesMatch "\.(webm|mp4|gif|png|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # CSS/JS changent a chaque deploiement, sous le meme nom.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

ErrorDocument 404 /404.html
